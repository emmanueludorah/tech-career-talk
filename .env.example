# Resend (https://resend.com) — used to email the organizer with the attendee's PDF
RESEND_API_KEY=re_your_api_key_here

# The event organizer's inbox that receives each registration email
ORGANIZER_EMAIL=udorahemmanuel23@gmail.com

# The "from" address Resend sends as. Must be a verified domain in Resend,
# or use the Resend sandbox address "onboarding@resend.dev" for local testing.
EMAIL_FROM="Tech & Career Talk 0.1 <onboarding@resend.dev>"

# PostgreSQL connection string for Prisma
# Example (local): postgresql://postgres:postgres@localhost:5432/tech_event?schema=public
# Example (hosted, e.g. Neon/Supabase): postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tech_event?schema=public
