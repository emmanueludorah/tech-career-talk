generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Registration {
  id                 String   @id @default(cuid())
  fullName           String
  email              String
  phone              String?
  location           String
  careerField        String
  experienceLevel    String
  learningExpectation String
  referralSource     String
  joinCommunity      Boolean
  createdAt          DateTime @default(now())

  // Prevents the same email from registering twice for this event.
  @@unique([email])
  @@index([email])
  @@index([createdAt])
  @@map("registrations")
}
